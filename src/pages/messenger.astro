    <img
      id="lightbox-img"
      src=""
      alt=""
      class="relative z-10 max-h-[90vh] max-w-[90vw] rounded-2xl border border-white/10 shadow-2xl cursor-pointer"
    />
  </div>

  <script>
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    let lightboxOpen = false;

    function openLightbox(src: string) {
      if (lightbox && lightboxImg) {
        lightboxImg.src = src;
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        lightboxOpen = true;
        history.pushState({ lightbox: true }, "");
      }
    }

    function closeLightbox() {
      if (lightbox && lightboxImg) {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightboxImg.src = "";
        if (lightboxOpen) {
          lightboxOpen = false;
          history.back();
        }
      }
    }

    function closeLightboxFromBack() {
      if (lightbox && lightboxImg) {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightboxImg.src = "";
        lightboxOpen = false;
      }
    }

    document.querySelectorAll(".screenshot-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-full");
        if (src) openLightbox(src);
      });
    });

    document.getElementById("lightbox-close-bg")?.addEventListener("click", closeLightbox);
    document.getElementById("lightbox-close-btn")?.addEventListener("click", closeLightbox);
    lightboxImg?.addEventListener("click", closeLightbox);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightboxOpen) closeLightbox();
    });

    window.addEventListener("popstate", () => {
      if (lightboxOpen) closeLightboxFromBack();
    });
  </script>
</Layout>
