---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";

const BUILD_SHA = import.meta.env.PUBLIC_BUILD_SHA ?? "";
const BUILD_SHORT = BUILD_SHA ? BUILD_SHA.slice(0, 7) : "dev";
const ONION_REPO = "http://yexg75vnfxe2q6yygn7csmqdx5mtwmvhrqpboopisvjqz7haras3skid.onion/anonomi/anonomi.org";
const CLEARNET_REPO = "https://github.com/anonomi-org/anonomi.org";
const COMMIT_URL = BUILD_SHA ? `${ONION_REPO}/commit/${BUILD_SHA}` : ONION_REPO;
const CLEARNET_COMMIT_URL = BUILD_SHA ? `${CLEARNET_REPO}/commit/${BUILD_SHA}` : CLEARNET_REPO;
---

<Layout
  title="Anonomi Messenger: Decentralized communication for hostile environments"
  description="Decentralized messaging for high-threat environments. Online over Tor or fully offline."
>
  <NavBar />

  <main class="mx-auto max-w-6xl px-6 py-16">
    <!-- HERO -->
    <section
      class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12"
    >
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-white/10 via-transparent to-transparent"
      >
      </div>

      <div
        class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="max-w-2xl">
          <p class="text-xs font-semibold tracking-widest text-zinc-400">
            NO SERVERS • TOR • OFFLINE
          </p>

          <h1
            class="mt-6 text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl"
          >
            Messaging built for hostile conditions.
          </h1>

          <p class="mt-4 text-zinc-300">
            Anonomi Messenger is an open source decentralized communication tool designed
            for high-threat environments. It works online over Tor, or
            completely offline over Wi-Fi, Bluetooth, and external storage.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#download"
              class="rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
            >
              Download
            </a>
            <a
              href="#features"
              class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
            >
              Explore features
            </a>
            <a
              href="/#manifesto"
              class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-300 ring-1 ring-white/10 hover:bg-white/5"
            >
              Read manifesto
            </a>
          </div>

          <p class="mt-6 text-xs text-zinc-500">
            Android-only. Built to reduce metadata exposure — not to promise
            magic anonymity.
          </p>
        </div>

        <!-- HERO SCREENSHOT -->
        <div class="w-full max-w-lg flex justify-center">
          <img
            src="/screenshots/intro.png"
            alt="Anonomi encrypted messaging interface"
            loading="lazy"
            class="max-h-[520px] w-auto rounded-2xl border border-white/10 shadow-2xl"
          />
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        The ultimate privacy tool
      </h2>

      <div class="mt-4 h-[2px] w-20 rounded-full bg-[#6d4aff]"></div>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        Anonomi Messenger is built around three pillars: communication,
        offline capabilities, and privacy & safety tools.
      </p>

      <!-- Category pillars -->
      <div class="mt-16 grid gap-10 sm:grid-cols-3">
        <!-- Communication -->
        <a href="#communication" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 10h8m-8 4h5m9-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Communication
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            Messaging, groups, voice, walkie-talkie, and decentralized blogs.
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Privacy & Safety -->
        <a href="#privacy-safety" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Privacy & Safety
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            Payments, voice distortion, panic button, and stealth mode.
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Offline & Network -->
        <a href="#offline-network" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7.5 12h9m-9 0a4.5 4.5 0 119 0m-9 0a4.5 4.5 0 009 0M4.5 12a7.5 7.5 0 1115 0 7.5 7.5 0 01-15 0z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Offline & Network
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            Transports, offline maps, app distribution, and Postbox.
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>
      </div>

      <!-- ═══════════════════════════════════════════ -->
      <!-- COMMUNICATION                              -->
      <!-- ═══════════════════════════════════════════ -->
      <div id="communication" class="mt-20 scroll-mt-24">
        <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          Communication
        </h3>
        <div class="mt-2 h-px w-12 bg-white/20"></div>
      </div>

      <div class="mt-10 space-y-14">
        <!-- Messaging -->
        <div id="feature-messaging" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 10h8m-8 4h5m9-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">Messaging</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                Encrypted, decentralized messaging designed for hostile networks — online
                over Tor or fully offline over local transports. No central infrastructure
                to seize, log, or subpoena.
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">No servers</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    No central infrastructure to seize, log, or subpoena.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Tor (online)</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Route communication through Tor, with bridges when blocked.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Offline modes</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Wi-Fi, Bluetooth, and external storage support when the
                    network is the threat.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Full media support</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Text, images, voice, and location sharing in every
                    conversation.
                  </p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href="/docs/features/connectivity"
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  Learn how Anonomi communicates in hostile environments
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/messaging.png">
                  <img
                    src="/screenshots/messaging.png"
                    alt="Anonomi messaging interface"
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Groups & Open Groups -->
        <div id="feature-groups" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">Groups & Open Groups</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                Create private groups for trusted circles or open groups (forums)
                for broader communities. Both support full media — text, images,
                voice, and location sharing.
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Private groups</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Invite-only groups for trusted contacts. All messages are
                    encrypted and synced peer-to-peer.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Open groups (forums)</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Public discussion spaces that anyone with an invitation link
                    can join. Threaded conversations for organized discussion.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Full media support</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Text, images, voice messages, and location sharing work in
                    both private groups and forums.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Threaded replies</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Reply to specific messages in group conversations to keep
                    discussions organized and easy to follow.
                  </p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href="/docs/features/groups"
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  Learn about groups and forums
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/groups.png">
                  <img
                    src="/screenshots/groups.png"
                    alt="Anonomi Groups"
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Voice Messages -->
        <div id="feature-voice" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">Voice Messages</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                Record and send voice messages in any conversation. Voice data is
                encrypted and transmitted through the same peer-to-peer network as
                text and images.
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Tap to record</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Hold the microphone button to record, release to review or send.
                    Works in private chats and groups.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Encrypted audio</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Voice data is encrypted end-to-end and routed through the same
                    peer-to-peer network as all other messages.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Works everywhere</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Send voice messages in private chats, groups, and forums —
                    over Tor or any offline transport.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Inline playback</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Play voice messages directly in the conversation without
                    leaving the chat or opening a separate player.
                  </p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href="/docs/features/voice"
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  Learn about voice messages
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/voice.png">
                  <img
                    src="/screenshots/voice.png"
                    alt="Anonomi Voice Messages"
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Walkie-Talkie -->
        <div id="feature-walkie-talkie" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m3.75 7.5 16.5-4.125M12 6.75c-2.708 0-5.363.224-7.948.655C2.999 7.58 2.25 8.507 2.25 9.574v9.176A2.25 2.25 0 0 0 4.5 21h15a2.25 2.25 0 0 0 2.25-2.25V9.574c0-1.067-.75-1.994-1.802-2.169A48.329 48.329 0 0 0 12 6.75Zm-1.683 6.443-.005.005-.006-.005.006-.005.005.005Zm-.005 2.127-.005-.006.005-.005.005.005-.005.006Zm-2.116-.006-.005.006-.006-.006.005-.005.006.005Zm-.005-2.116-.006-.005.006-.005.005.005-.005.005ZM9.255 10.5v.008h-.008V10.5h.008Zm3.249 1.88-.007.004-.003-.007.006-.003.004.006Zm-1.38 5.126-.003-.006.006-.004.004.007-.006.003Zm.007-6.501-.003.006-.007-.003.004-.007.006.004Zm1.37 5.129-.007-.004.004-.006.006.003-.004.007Zm.504-1.877h-.008v-.007h.008v.007ZM9.255 18v.008h-.008V18h.008Zm-3.246-1.87-.007.004L6 16.127l.006-.003.004.006Zm1.366-5.119-.004-.006.006-.004.004.007-.006.003ZM7.38 17.5l-.003.006-.007-.003.004-.007.006.004Zm-1.376-5.116L6 12.38l.003-.007.007.004-.004.007Zm-.5 1.873h-.008v-.007h.008v.007ZM17.25 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm0 4.5a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">Walkie-Talkie</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                Push-to-talk voice messaging via the volume button. Hold to record,
                release to send. Incoming messages auto-play for hands-free
                communication in the field.
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Volume button trigger</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Press and hold the volume button to record. Release to send
                    instantly — no need to touch the screen.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Auto-play incoming</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Incoming walkie-talkie messages play automatically through the
                    speaker for true hands-free operation.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">One conversation at a time</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    Select a contact and use the volume button to send instant
                    voice bursts — simple, focused, and distraction-free.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">Encrypted push-to-talk</div>
                  <p class="mt-2 text-sm text-zinc-400">
                    All walkie-talkie audio is end-to-end encrypted and routed
                    through the same secure network as regular messages.
                  </p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href="/docs/features/walkie-talkie"
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  Learn about walkie-talkie mode
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/walkie-talkie.png">
                  <img
                    src="/screenshots/walkie-talkie.png"
                    alt="Anonomi Walkie-Talkie"
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Blogs -->
        <div id="feature-blogs" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
