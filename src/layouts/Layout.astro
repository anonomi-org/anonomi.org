---
import "../styles/global.css";
import { defaultLocale, directionOf } from "../i18n/locales";
import { IS_ONION_BUILD, ONION_SITE_BASE } from "../lib/site";

const { title = "Anonomi", description = "Private chat over Tor." } =
  Astro.props;

const locale = Astro.currentLocale || defaultLocale;
const dir = directionOf(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Send no Referer at all. Following a link off the onion would otherwise
        tell the other site which onion the visitor came from. Nothing here
        needs a referrer, and CORS uses Origin, which this does not touch. */}
    <meta name="referrer" content="no-referrer" />
    {
      /* Tor Browser offers the onion when it sees this. It only honours it on
         an HTTPS page that is not already an onion, so the onion build leaves
         it out. It always points at the front page — the tag cannot carry the
         path the visitor is on. */
      !IS_ONION_BUILD && (
        <meta http-equiv="onion-location" content={ONION_SITE_BASE} />
      )
    }
    <title>{title}</title>
    <noscript>
      <style>
        /* Tor Browser's Safest level turns JavaScript off, and the menu and
           language picker are opened by script. Show the menu instead, and
           hide the buttons that would have opened it. The ids outrank the
           utility classes that hide these, so no media query is involved. */
        #menu-toggle,
        #lang-dropdown-desktop {
          display: none;
        }
        #mobile-menu {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <slot />
  </body>
</html>
