---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const BUILD_SHA = import.meta.env.PUBLIC_BUILD_SHA ?? "";
const BUILD_SHORT = BUILD_SHA ? BUILD_SHA.slice(0, 7) : "dev";
const ONION_REPO = "http://ll7nb2gloylmzcnb4q6apax6zt4c5gbdvx73cvf7fj4frep7zsgdeoqd.onion/anonomi/anonomi.org";
const CLEARNET_REPO = "https://github.com/anonomi-org/anonomi.org";
const COMMIT_URL = BUILD_SHA ? `${ONION_REPO}/commit/${BUILD_SHA}` : ONION_REPO;
const CLEARNET_COMMIT_URL = BUILD_SHA ? `${CLEARNET_REPO}/commit/${BUILD_SHA}` : CLEARNET_REPO;

const API_BASE =
  import.meta.env.PUBLIC_PAYLINKS_API_BASE ?? "http://localhost:8787";

const docsWhatIsPath = localizedPath("/docs/paylinks/what-is", lang);
const docsPrivacyPath = localizedPath("/docs/paylinks/privacy", lang);

const scriptStrings = {
  invalidHeading: t(lang, "paylinks.d.invalidLink.heading"),
  invalidText: t(lang, "paylinks.d.invalidLink.text"),
  donateHeading: t(lang, "paylinks.d.donate.heading"),
  amountLabel: t(lang, "paylinks.d.donate.amountLabel"),
  whatIs: t(lang, "paylinks.d.donate.whatIs"),
  descLabel: t(lang, "paylinks.d.donate.descLabel"),
  submit: t(lang, "paylinks.d.donate.submit"),
  infoBefore: t(lang, "paylinks.d.donate.info.before"),
  infoHighlight: t(lang, "paylinks.d.donate.info.highlight"),
  privacyBefore: t(lang, "paylinks.d.donate.info.privacy.before"),
  privacyHighlight: t(lang, "paylinks.d.donate.info.privacy.highlight"),
  privacyLearnMore: t(lang, "paylinks.d.donate.info.privacy.learnMore"),
  unavailable: t(lang, "paylinks.d.donate.unavailable"),
  loadFailed: t(lang, "paylinks.d.donate.loadFailed"),
  resultHeading: t(lang, "paylinks.d.result.heading"),
  resultAddress: t(lang, "paylinks.d.result.address"),
  openInWallet: t(lang, "paylinks.d.result.openInWallet"),
  copyAddress: t(lang, "paylinks.d.result.copyAddress"),
  copied: t(lang, "paylinks.d.result.copied"),
  invalidUri: t(lang, "paylinks.d.result.invalidUri"),
  requestFailed: t(lang, "paylinks.d.result.requestFailed"),
  generating: t(lang, "paylinks.d.script.generating"),
  generated: t(lang, "paylinks.d.script.generated"),
  errorHeading: t(lang, "paylinks.d.error.heading"),
  errorDefault: t(lang, "paylinks.d.error.default"),
  docsWhatIsPath,
  docsPrivacyPath,
};
---

<Layout
  title={t(lang, "paylinks.d.meta.title")}
  description={t(lang, "paylinks.d.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-xl px-6 py-16">
    <div class="relative">
      <section
        id="paylink"
        class="rounded-3xl border border-white/10 bg-white/5 p-8 text-center">
        <h1 class="text-2xl font-semibold">{t(lang, "paylinks.d.loading.heading")}</h1>
        <p class="mt-3 text-sm text-zinc-400" id="status">{t(lang, "paylinks.d.loading.status")}</p>
      </section>

      <!-- Footer stays OUTSIDE #paylink so it doesn't get wiped by innerHTML -->
      <div
        class="mt-4 flex items-center justify-between font-mono text-[11px] text-zinc-500"
      >
        <div id="footerFingerprint" class="hidden">
          {t(lang, "paylinks.d.footerFingerprint")}
          <span id="footerFingerprintValue" class="text-zinc-300"></span>
        </div>

        <div>
          Build:
          <a href={COMMIT_URL} data-clearnet-href={CLEARNET_COMMIT_URL} class="text-zinc-300 hover:text-white">
            {BUILD_SHORT}
          </a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ API_BASE, scriptStrings }}>
    window.__PAYLINKS_API_BASE__ = API_BASE;
    window.__PAYLINKS_STRINGS__ = scriptStrings;
  </script>

  <script>
    import QRCode from "qrcode";

    const API_BASE = window.__PAYLINKS_API_BASE__ || "http://localhost:8787";
    const S = window.__PAYLINKS_STRINGS__ || {};

    const container = document.getElementById("paylink");

    // Read UUID from URL fragment (#...)
    const id = window.location.hash.slice(1);

    const UUID_RE =
      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    function esc(s) {
      return String(s)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    if (!id || !UUID_RE.test(id)) {
      container.innerHTML = `
        <h1 class="text-2xl font-semibold">${esc(S.invalidHeading)}</h1>
        <p class="mt-3 text-sm text-zinc-400">
          ${esc(S.invalidText)}
        </p>
      `;
      throw new Error("Invalid paylink id");
    }

    async function run() {
      container.innerHTML = `
        <h1 class="text-2xl font-semibold">${esc(S.donateHeading)}</h1>

        <p id="labelLine" class="mt-2 hidden text-xs uppercase tracking-wide text-zinc-400"></p>

        <form id="donateForm" class="mt-6 text-left">
          <div class="flex items-center justify-between">
          <label class="block text-sm text-zinc-300">
            ${esc(S.amountLabel)}
          </label>

          <a
            href="${esc(S.docsWhatIsPath)}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1 text-xs text-zinc-500 hover:text-zinc-300"
          >
            <span
              aria-hidden="true"
              class="text-[11px] font-medium"
              style="color:#ce27e6"
            >
              &#9432;
            </span>
            <span>
              ${esc(S.whatIs)}
            </span>
          </a>
        </div>
          <input
            id="amount"
            class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-zinc-100 outline-none"
            placeholder="e.g. 0.15"
            inputmode="decimal"
            autocomplete="off"
          />

          <label class="mt-4 block text-sm text-zinc-300">${esc(S.descLabel)}</label>
          <input
            id="desc"
            class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-zinc-100 outline-none"
            placeholder="e.g. Donation for content"
            maxlength="140"
            autocomplete="off"
          />

          <button
            id="btn"
            type="submit"
            class="mt-6 w-full rounded-xl bg-white/10 px-4 py-3 text-sm font-medium ring-1 ring-white/15 hover:bg-white/15"
          >
            ${esc(S.submit)}
          </button>
          <div class="mt-3 rounded-xl border border-white/10 bg-black/30 px-4 py-3">
            <p class="flex items-start gap-2 text-xs text-zinc-500">
              <span
                aria-hidden="true"
                class="mt-[1px] font-medium"
                style="color:#ce27e6"
              >
                &#9432;
              </span>
              <span>
                ${esc(S.infoBefore)}
                <span class="font-medium text-zinc-400">
                  ${esc(S.infoHighlight)}
                </span>
                <span class="block mt-1">
                  ${esc(S.privacyBefore)}
                  <span class="font-medium text-zinc-400">
                    ${esc(S.privacyHighlight)}
                  </span>
                  <a
                    href="${esc(S.docsPrivacyPath)}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-1 underline underline-offset-2 hover:text-zinc-300"
                  >
                    ${esc(S.privacyLearnMore)}
                  </a>
                </span>
              </span>
            </p>
          </div>
        </form>

        <div id="result" class="mt-8"></div>
      `;

      const labelLine = document.getElementById("labelLine");
      const footerFpWrap = document.getElementById("footerFingerprint");
      const footerFpValue = document.getElementById("footerFingerprintValue");

      // Load meta (label + fingerprint)
      try {
        const metaRes = await fetch(`${API_BASE}/api/paylinks/${id}/meta`, {
          method: "GET",
        });
        const meta = await metaRes.json().catch(() => ({}));

        if (!metaRes.ok) {
          const msg =
            meta?.error === "paylink_unavailable"
              ? S.unavailable
              : S.loadFailed;
          throw new Error(msg);
        }

        const label = typeof meta?.label === "string" ? meta.label.trim() : "";
        if (labelLine) {
          labelLine.textContent = label || "";
          labelLine.classList.toggle("hidden", !label);
        }

        // Only set footer fingerprint
        const fingerprint =
          typeof meta?.fingerprint === "string" ? meta.fingerprint.trim() : "";
        if (fingerprint && footerFpWrap && footerFpValue) {
          footerFpValue.textContent = fingerprint;
          footerFpWrap.classList.remove("hidden");
        }
      } catch (e) {
        throw e;
      }

      const form = document.getElementById("donateForm");
      const result = document.getElementById("result");
      const btn = document.getElementById("btn");

      let paymentGenerated = false;

      async function requestPayment(amount, description) {
        if (paymentGenerated) return;

        btn.disabled = true;
        btn.textContent = S.generating;
        result.innerHTML = "";

        try {
          const payload = {
            description,
            ...(amount ? { amount } : {}),
          };

          const res = await fetch(`${API_BASE}/api/paylinks/${id}/request`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            const msg =
              data?.error === "paylink_unavailable"
                ? S.unavailable
                : data?.error || S.requestFailed;
            throw new Error(msg);
          }

          const address = data.address;
          const uri = data.uri;

          // Validate URI protocol to prevent javascript: XSS
          if (!uri || !uri.toLowerCase().startsWith("monero:")) {
            throw new Error(S.invalidUri);
          }

          result.innerHTML = `
            <div class="rounded-2xl border border-white/10 bg-black/20 p-5">
              <div class="text-sm font-semibold text-zinc-200">${esc(S.resultHeading)}</div>

              <div class="mt-5 flex justify-center">
                <canvas id="qr" class="rounded-2xl bg-white p-3"></canvas>
              </div>

              <div class="mt-5 text-xs text-zinc-400">${esc(S.resultAddress)}</div>
              <div class="mt-1 font-mono text-[12px] break-all text-zinc-200" id="addr">
                ${esc(address)}
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <a
                  id="open"
                  href="${esc(uri)}"
                  class="rounded-xl bg-white/10 px-4 py-3 text-center text-sm font-medium ring-1 ring-white/15 hover:bg-white/15"
                  rel="nofollow noopener"
                >
                  ${esc(S.openInWallet)}
                </a>
                <button
                  id="copyBtn"
                  class="rounded-xl px-4 py-3 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
                  type="button"
                >
                  ${esc(S.copyAddress)}
                </button>
              </div>
            </div>
          `;

          const qrCanvas = document.getElementById("qr");
          await QRCode.toCanvas(qrCanvas, uri, { margin: 1, width: 280 });

          document
            .getElementById("copyBtn")
            .addEventListener("click", async () => {
              await navigator.clipboard.writeText(address);
              const b = document.getElementById("copyBtn");
              b.textContent = S.copied;
              setTimeout(() => (b.textContent = S.copyAddress), 1200);
            });

          paymentGenerated = true;
          btn.disabled = true;
          btn.textContent = S.generated;
          btn.classList.add("opacity-60", "cursor-not-allowed");
        } catch (e) {
          btn.disabled = false;
          btn.textContent = S.submit;
          throw e;
        }
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const amount = document.getElementById("amount").value.trim();
        const description = document.getElementById("desc").value.trim();
        requestPayment(amount, description);
      });
    }

    run().catch((e) => {
      console.error(e);
      container.innerHTML = `
        <h1 class="text-2xl font-semibold">${esc(S.errorHeading)}</h1>
        <p class="mt-3 text-sm text-zinc-400">${esc(
          e?.message || S.errorDefault,
        )}</p>
      `;
    });
  </script>
</Layout>
