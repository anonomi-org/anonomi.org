---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import Footer from "../Footer.astro";
import PaylinksOnionNotice from "../PaylinksOnionNotice.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";
import { PAYLINKS_ENABLED } from "../../lib/paylinks";

const lang = getLangFromUrl(Astro.url);
---

<Layout
  title={t(lang, "paylinks.meta.title")}
  description={t(lang, "paylinks.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-6xl px-6 py-16">
    <!-- HERO -->
    <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12">
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-white/10 via-transparent to-transparent"></div>

      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest text-zinc-400">
          {t(lang, "paylinks.hero.tagline")}
        </p>

        <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
          {t(lang, "paylinks.hero.heading")}
        </h1>

        <p class="mt-4 text-zinc-300">
          {t(lang, "paylinks.hero.description")}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {PAYLINKS_ENABLED && (
          <a
            href={localizedPath("/paylinks/create", lang)}
            class="rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
          >
            {t(lang, "paylinks.hero.create")}
          </a>
          )}
          <a
            href="#how-it-works"
            class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
          >
            {t(lang, "paylinks.hero.howItWorks")}
          </a>
          <a
            href={localizedPath("/docs/paylinks/what-is", lang)}
            class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-300 ring-1 ring-white/10 hover:bg-white/5"
          >
            {t(lang, "paylinks.hero.learnMore")}
          </a>
        </div>

        <p class="mt-6 text-xs text-zinc-500">
          {t(lang, "paylinks.hero.disclaimer")}
        </p>
      </div>
    </section>

    {!PAYLINKS_ENABLED && (
      <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.04] p-6 sm:p-8">
        <PaylinksOnionNotice path="/paylinks" />
      </div>
    )}

    <!-- WHO IS IT FOR -->
    <section id="who" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "paylinks.who.heading")}
      </h2>

      <div class="mt-4 h-[2px] w-20 rounded-full bg-fuchsia-500/90"></div>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "paylinks.who.description")}
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.who.journalists.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.who.journalists.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.who.bloggers.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.who.bloggers.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.who.activists.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.who.activists.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.who.creators.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.who.creators.desc")}
          </p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "paylinks.how.heading")}
      </h2>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "paylinks.how.description")}
      </p>

      <!-- Publishers -->
      <div class="mt-12">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5">
            <svg class="h-5 w-5 text-zinc-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 1115 0" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold tracking-tight">{t(lang, "paylinks.how.publishers.title")}</h3>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.publishers.step1")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.publishers.step1.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.publishers.step1.desc")}
            </p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.publishers.step2")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.publishers.step2.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.publishers.step2.desc")}
            </p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.publishers.step3")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.publishers.step3.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.publishers.step3.desc")}
            </p>
          </div>
        </div>

        {PAYLINKS_ENABLED && (
        <div class="mt-6">
          <a
            href={localizedPath("/paylinks/create", lang)}
            class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
          >
            {t(lang, "paylinks.how.publishers.cta")}
          </a>
        </div>
        )}
      </div>

      <!-- Donors -->
      <div class="mt-14">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5">
            <svg class="h-5 w-5 text-zinc-300" viewBox="0 0 16 16" fill="currentColor">
              <path d="M11.28774193548387 12.046451612903226h3.426838709677419
                C13.34258064516129 14.31941935483871 10.848322580645162 15.84 8 15.84
                S2.6574193548387095 14.31941935483871 1.2854193548387096 12.046451612903226
                H4.71225806451613V8.006322580645161L8 11.319354838709677
                11.28774193548387 8v4.046451612903225ZM2.9419354838709677 10.529032258064515
                V3.9535483870967743l5.039096774193548 5.039096774193548
                L13.058064516129033 3.9535483870967743V10.529032258064515
                h2.3646451612903228c0.2687096774193548 -0.7934838709677419
                0.41729032258064513 -1.6438709677419354
                0.41729032258064513 -2.5290322580645164
                C15.84 3.669032258064516 12.330967741935483 0.16 8 0.16
                S0.16 3.669032258064516 0.16 8
                c0 0.8851612903225806 0.14541935483870969 1.735548387096774
                0.41729032258064513 2.5290322580645164H2.9419354838709677Z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold tracking-tight">{t(lang, "paylinks.how.donors.title")}</h3>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.donors.step1")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.donors.step1.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.donors.step1.desc")}
            </p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.donors.step2")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.donors.step2.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.donors.step2.desc")}
            </p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-medium text-fuchsia-400">{t(lang, "paylinks.how.donors.step3")}</div>
            <div class="mt-1 font-medium">{t(lang, "paylinks.how.donors.step3.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.how.donors.step3.desc")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PRIVACY -->
    <section id="privacy" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "paylinks.privacy.heading")}
      </h2>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "paylinks.privacy.description")}
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.privacy.noSpendKey.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.privacy.noSpendKey.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.privacy.noLogging.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.privacy.noLogging.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.privacy.freshAddress.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.privacy.freshAddress.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.privacy.donorIsolation.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.privacy.donorIsolation.desc")}
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-6">
        <a
          href={localizedPath("/docs/paylinks/privacy", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.privacy.docsLink")}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={localizedPath("/docs/paylinks/infrastructure", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.privacy.infraLink")}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- CLEARNET & TOR -->
    <section id="tor" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "paylinks.tor.heading")}
      </h2>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "paylinks.tor.description")}
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.tor.noCrossOrigin.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.tor.noCrossOrigin.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.tor.trafficIsolation.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.tor.trafficIsolation.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.tor.independentInfra.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.tor.independentInfra.desc")}
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.tor.createWherePublish.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.tor.createWherePublish.desc")}
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-6">
        <a
          href={localizedPath("/docs/paylinks/tor-separation", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.tor.whySeparate")}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={localizedPath("/docs/onion-services", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.tor.aboutOnion")}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- DISTINCTION -->
    <section id="distinction" class="mt-24 scroll-mt-24">
      <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 sm:p-8">
        <h3 class="text-2xl font-semibold tracking-tight">{t(lang, "paylinks.distinction.heading")}</h3>

        <p class="mt-3 text-zinc-400">
          {t(lang, "paylinks.distinction.description")}
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="font-medium text-fuchsia-400">{t(lang, "paylinks.distinction.paylinks.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.distinction.paylinks.desc")}
            </p>
            <p class="mt-2 text-xs text-zinc-500">{t(lang, "paylinks.distinction.paylinks.bestFor")}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="font-medium text-zinc-300">{t(lang, "paylinks.distinction.messenger.title")}</div>
            <p class="mt-2 text-sm text-zinc-400">
              {t(lang, "paylinks.distinction.messenger.desc")}
            </p>
            <p class="mt-2 text-xs text-zinc-500">{t(lang, "paylinks.distinction.messenger.bestFor")}</p>
          </div>
        </div>

        <div class="mt-6">
          <a
            href={localizedPath("/messenger", lang) + "#tab-payments"}
            class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
          >
            {t(lang, "paylinks.distinction.messengerLink")}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- GET STARTED -->
    <section id="get-started" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "paylinks.getStarted.heading")}
      </h2>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "paylinks.getStarted.description")}
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.getStarted.create.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.getStarted.create.desc")}
          </p>
          {PAYLINKS_ENABLED && (
          <div class="mt-4">
            <a
              href={localizedPath("/paylinks/create", lang)}
              class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
            >
              {t(lang, "paylinks.getStarted.create.button")}
            </a>
          </div>
          )}
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "paylinks.getStarted.delete.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "paylinks.getStarted.delete.desc")}
          </p>
          {PAYLINKS_ENABLED && (
          <div class="mt-4">
            <a
              href={localizedPath("/paylinks/delete", lang)}
              class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
            >
              {t(lang, "paylinks.getStarted.delete.button")}
            </a>
          </div>
          )}
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-6">
        <a
          href={localizedPath("/docs/paylinks/what-is", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.getStarted.whatIs")}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={localizedPath("/docs/paylinks/privacy", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.getStarted.privacyDocs")}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={localizedPath("/", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "paylinks.getStarted.backHome")}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
