---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import Footer from "../Footer.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";
import {
  IS_ONION_BUILD,
  ONION_REPO_BASE,
  ONION_SITE_BASE,
  net,
  repoUrl,
} from "../../lib/site";

const lang = getLangFromUrl(Astro.url);

// The paylink id rides in the fragment so it is never sent to a server. The
// trailing slash on /d/ is deliberate: without it nginx answers with a
// redirect, costing an extra Tor round trip before the page loads.
const TOR_DONATE_URL = `${ONION_SITE_BASE}/paylinks/d/#62df277a-21d7-4447-a007-6b5856d6d3ea`;
---

<Layout
  title={t(lang, "home.meta.title")}
  description={t(lang, "home.meta.description")}
>
  <NavBar />

  <!-- HERO SECTION -->
  <section
    id="statement"
    class="relative flex min-h-screen items-center justify-center px-6"
  >
    <!-- Background -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <!-- Base wash matches body -->
      <div class="absolute inset-0 bg-zinc-950"></div>

      <!-- Subtle vertical depth (no black at the end) -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-zinc-900/60 via-zinc-950 to-zinc-950"
      >
      </div>

      <!-- Much dimmer radial highlight -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03),transparent_60%)]"
      >
      </div>

      <!-- Bottom "settle" overlay so it matches the next section -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-zinc-950"
      >
      </div>
    </div>

    <div class="mx-auto max-w-5xl text-center">
      <h1
        class="text-5xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
      >
        <span class="block">
          {t(lang, "home.hero.heading.before")}<span class="text-fuchsia-500/90">{t(lang, "home.hero.heading.highlight")}</span>
        </span>
        <span class="mt-4 block text-zinc-100 text-4xl sm:text-5xl lg:text-6xl">
          {t(lang, "home.hero.subtitle")}
        </span>
      </h1>

      <p class="mx-auto mt-8 max-w-3xl text-base text-zinc-300 sm:text-lg">
        {t(lang, "home.hero.description.before")}<span class="text-red-500">{t(lang, "home.hero.description.highlight")}</span>{t(lang, "home.hero.description.after")}
      </p>

      <div class="mt-16"></div>

      <p class="mt-6 text-xs font-semibold tracking-widest text-zinc-100">
        {t(lang, "home.hero.tagline")}
      </p>
    </div>
  </section>

  <!-- MANIFESTO (INTRO) -->
  <section id="manifesto" class="mt-4 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "home.manifesto.heading")}
      </h2>

      <p class="mt-4 max-w-4xl text-base text-zinc-300 sm:text-lg">
        {t(lang, "home.manifesto.p1")}
      </p>

      <p class="mt-4 max-w-4xl text-base text-zinc-300 sm:text-lg">
        {t(lang, "home.manifesto.p2")}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={localizedPath("/docs/manifesto", lang)}
          class="rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
        >
          {t(lang, "home.manifesto.cta")}
        </a>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-6 pb-16">
    <section id="products" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "home.products.heading")}
      </h2>

      <div class="mt-4 h-[2px] w-20 rounded-full bg-fuchsia-500/90"></div>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "home.products.description")}
      </p>

      <!-- Stacked selectors (like messenger features, but vertical) -->
      <div class="mt-12 space-y-10">
        <!-- Messenger -->
        <a href={localizedPath("/messenger", lang)} class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 10h8m-8 4h5m9-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Anonomi Messenger
            </h3>

            <span
              class="ml-auto text-sm text-zinc-400 group-hover:text-zinc-200"
              >{t(lang, "home.products.open")}</span
            >
          </div>

          <p
            class="mt-3 max-w-3xl text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "home.products.messenger.description")}
          </p>

          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.messenger.tag1")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.messenger.tag2")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.messenger.tag3")}</span
            >
          </div>

          <div class="mt-5 h-px w-24 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Paylinks -->
        <a href={localizedPath("/paylinks", lang)} class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6v12m-6-6h12"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Anonomi Paylinks
            </h3>

            <span
              class="ml-auto text-sm text-zinc-400 group-hover:text-zinc-200"
              >{t(lang, "home.products.open")}</span
            >
          </div>

          <p
            class="mt-3 max-w-3xl text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "home.products.paylinks.description")}
          </p>

          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.paylinks.tag1")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.paylinks.tag2")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.paylinks.tag3")}</span
            >
          </div>

          <p class="mt-3 text-xs text-zinc-500">
            {t(lang, "home.products.paylinks.note.before")}<span class="text-zinc-300">{t(lang, "home.products.paylinks.note.highlight")}</span>{t(lang, "home.products.paylinks.note.after")}
          </p>

          <div class="mt-5 h-px w-24 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Maps -->
        <a href={localizedPath("/maps", lang)} class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 20l-5-2V6l5 2 6-2 5 2v12l-5-2-6 2z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              Anonomi Maps
            </h3>

            <span
              class="ml-auto text-sm text-zinc-400 group-hover:text-zinc-200"
              >{t(lang, "home.products.open")}</span
            >
          </div>

          <p
            class="mt-3 max-w-3xl text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "home.products.maps.description")}
          </p>

          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.maps.tag1")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.maps.tag2")}</span
            >
            <span
              class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
              >{t(lang, "home.products.maps.tag3")}</span
            >
          </div>

          <div class="mt-5 h-px w-24 bg-white/20 group-hover:bg-white/40"></div>
        </a>
      </div>
    </section>

    <!-- OPEN -->
    <section id="open" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t(lang, "home.open.heading")}</h2>
      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "home.open.description")}
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "home.open.opensource.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.open.opensource.desc")}
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "home.open.notrackers.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.open.notrackers.desc")}
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "home.open.community.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.open.community.desc")}
          </p>
        </div>
      </div>

      <!-- Onion repository -->
      <div class="mt-16">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-purple-500/30 bg-purple-500/10"
          >
            <img
              src="/icons/tor.svg"
              alt="Tor"
              class="h-5 w-5 text-purple-400"
              style="filter: brightness(0) saturate(100%) invert(38%) sepia(74%) saturate(561%) hue-rotate(240deg);"
            />
          </div>

          <h3 class="text-2xl font-semibold tracking-tight">
            {t(lang, "home.open.onionrepo.heading")}
          </h3>
        </div>

        <p class="mt-3 max-w-3xl text-base text-zinc-400">
          {t(lang, "home.open.onionrepo.p1.before")}<strong class="font-medium text-zinc-300"
            >{t(lang, "home.open.onionrepo.p1.highlight")}</strong
          >{t(lang, "home.open.onionrepo.p1.after")}
        </p>

        <p class="mt-3 max-w-3xl text-base text-zinc-400">
          {t(lang, "home.open.onionrepo.p2")}
        </p>
      </div>

      <div class="mt-8 space-y-3">
        <!-- Onion repo (always onion) -->
        <a
          href={ONION_REPO_BASE}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          <span>{t(lang, "home.open.onionrepo.explore")}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <!-- Tor Browser hint -->
        <p class="max-w-3xl text-sm text-zinc-500">
          {t(lang, "home.open.onionrepo.torhint.before")}
          <a
            href="https://www.torproject.org/download/"
            target="_blank"
            rel="noreferrer"
            class="ml-1 text-zinc-300 hover:text-white underline underline-offset-4"
          >
            {t(lang, "home.open.onionrepo.torhint.download")}
          </a>
          {t(lang, "home.open.onionrepo.torhint.after")}
        </p>
      </div>

      <!-- Anonomi loves Tor -->
      <div class="mt-16">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-purple-500/30 bg-purple-500/10"
          >
            <svg
              class="h-5 w-5 text-purple-400"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              ></path>
            </svg>
          </div>

          <h3 class="text-2xl font-semibold tracking-tight">
            {t(lang, "home.open.lovesfor.heading")}
          </h3>
        </div>

        <p class="mt-3 max-w-3xl text-base text-zinc-400">
          {t(lang, "home.open.lovesfor.p1.before")}<strong
            class="font-medium text-zinc-300"
            >{t(lang, "home.open.lovesfor.p1.highlight")}</strong
          >{t(lang, "home.open.lovesfor.p1.after")}
        </p>

        <p class="mt-3 max-w-3xl text-base text-zinc-400">
          {t(lang, "home.open.lovesfor.p2")}
        </p>

        <div class="mt-6">
          <a
            href={localizedPath("/docs/tor", lang)}
            class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
          >
            <span>{t(lang, "home.open.lovesfor.cta")}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ABOUT US -->
    <section id="about" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "home.about.heading")}
      </h2>
      <p class="mt-2 text-lg font-medium text-zinc-300">
        {t(lang, "home.about.subtitle")}
      </p>

      <p class="mt-6 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "home.about.p1")}
      </p>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "home.about.p2")}
      </p>

      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        <div
          class="rounded-2xl border border-white/10 bg-white/5 p-6 lg:col-span-2"
        >
          <div class="text-base font-semibold">{t(lang, "home.about.building.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.about.building.desc")}
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-white/10 bg-white/5 p-4">
              <div class="font-medium">{t(lang, "home.about.building.community.title")}</div>
              <p class="mt-1 text-sm text-zinc-400">
                {t(lang, "home.about.building.community.desc")}
              </p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/5 p-4">
              <div class="font-medium">{t(lang, "home.about.building.threat.title")}</div>
              <p class="mt-1 text-sm text-zinc-400">
                {t(lang, "home.about.building.threat.desc")}
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "home.about.project.title")}</div>
          <ul class="mt-3 space-y-2 text-sm text-zinc-400">
            <li>{t(lang, "home.about.project.item1")}</li>
            <li>{t(lang, "home.about.project.item2")}</li>
            <li>{t(lang, "home.about.project.item3")}</li>
            <li>{t(lang, "home.about.project.item4")}</li>
            <li>{t(lang, "home.about.project.item5")}</li>
          </ul>

          <div class="mt-6">
            <a
              href={localizedPath("/docs/manifesto", lang)}
              class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
            >
              {t(lang, "home.about.project.cta")} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SUPPORT THE PROJECT -->
    <section id="supporters" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "home.support.heading")}
      </h2>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "home.support.description")}
      </p>

      <div class="mt-10 grid gap-4">
        <!-- Developers -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">{t(lang, "home.support.devs.title")}</div>
          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.support.devs.desc")}
          </p>
        </div>

        <!-- Financial + Tor -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-base font-semibold">
            {t(lang, "home.support.financial.title")}
          </div>

          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.support.financial.p1")}
          </p>

          <p class="mt-3 text-sm text-zinc-400">
            {t(lang, "home.support.financial.p2")}
          </p>

          <p class="mt-3 text-sm font-semibold text-zinc-300">
            {t(lang, "home.support.financial.p3")}
          </p>
        </div>

        <!-- Donations -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="text-base font-semibold">
              {t(lang, "home.support.donate.title")}
            </div>

            <div class="flex items-center gap-2 text-xs">
              <span
                class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
                >{t(lang, "home.support.donate.tag1")}</span
              >
              <span
                class="rounded-full bg-white/10 px-3 py-1 font-medium text-zinc-300"
                >{t(lang, "home.support.donate.tag2")}</span
              >
            </div>
          </div>

          <p class="mt-2 text-sm text-zinc-400">
            {t(lang, "home.support.donate.desc")}
          </p>

          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            <!-- XMR (Anonomi Paylinks) -->
            <div class="rounded-xl border border-white/10 bg-black/20 p-4">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5"
                >
                  <!-- Monero SVG -->
                  <svg
                    class="h-4 w-4 text-zinc-300"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M11.28774193548387 12.046451612903226h3.426838709677419
                      C13.34258064516129 14.31941935483871 10.848322580645162 15.84 8 15.84
                      S2.6574193548387095 14.31941935483871 1.2854193548387096 12.046451612903226
                      H4.71225806451613V8.006322580645161L8 11.319354838709677
                      11.28774193548387 8v4.046451612903225ZM2.9419354838709677 10.529032258064515
                      V3.9535483870967743l5.039096774193548 5.039096774193548
                      L13.058064516129033 3.9535483870967743V10.529032258064515
                      h2.3646451612903228c0.2687096774193548 -0.7934838709677419
                      0.41729032258064513 -1.6438709677419354
                      0.41729032258064513 -2.5290322580645164
                      C15.84 3.669032258064516 12.330967741935483 0.16 8 0.16
                      S0.16 3.669032258064516 0.16 8
                      c0 0.8851612903225806 0.14541935483870969 1.735548387096774
                      0.41729032258064513 2.5290322580645164H2.9419354838709677Z"
                    ></path>
                  </svg>
                </div>

                <div class="text-sm font-semibold text-zinc-200">
                  Monero (XMR)
                  <span class="ml-2 text-xs font-medium text-fuchsia-500/90"
                    >{t(lang, "home.support.donate.xmr.preferred")}</span
                  >
                </div>
              </div>

              <p class="mt-3 text-sm text-zinc-400">
                {t(lang, "home.support.donate.xmr.desc")}
              </p>

              <div class="mt-4">
                {
                  /*
                    On the onion build this donates directly. On clearnet it
                    points at the Paylinks page, which explains that Paylinks
                    is onion-only and shows the address — the donation itself
                    cannot happen here.
                  */
                }
                <a
                  href={IS_ONION_BUILD ? TOR_DONATE_URL : localizedPath("/paylinks", lang)}
                  target={IS_ONION_BUILD ? "_blank" : undefined}
                  rel="nofollow noopener"
                  class="inline-flex items-center gap-2.5 rounded-xl bg-white/[0.06] px-4 py-2.5 text-sm font-semibold text-[#eaeaf0] no-underline ring-1 ring-white/[0.12] hover:bg-white/10"
                >
                  <span
                    class="inline-block h-2.5 w-2.5 rounded-full bg-[#ce27e6]"
                  ></span>
                  {t(lang, "home.support.donate.xmr.button")}
                </a>
              </div>

              <p class="mt-3 text-xs text-zinc-500">
                {t(lang, "home.support.donate.xmr.powered.before")}<a
                  href={localizedPath("/paylinks", lang)}
                  class="text-zinc-400 hover:text-white underline underline-offset-2"
                  >{t(lang, "home.support.donate.xmr.powered.link")}</a
                >
              </p>
            </div>

            <!-- BTC -->
            <div class="rounded-xl border border-white/10 bg-black/20 p-4">
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5"
                  >
                    <!-- Bitcoin SVG -->
                    <svg
                      class="h-4 w-4 text-zinc-300"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M13.5 10.5c.9-.3 1.5-1 1.5-2 0-1.5-1.2-2.5-3-2.5H10V4H8v2H6v2h2v8H6v2h2v2h2v-2h2.2c2 0 3.8-1 3.8-3
                        0-1.3-.7-2.3-2-2.7zM10 8h2c.8 0 1.5.3 1.5 1s-.7 1-1.5 1H10V8zm2.2 8H10v-3h2.2c1 0 1.8.4 1.8 1.5S13.2 16 12.2 16z"
                      ></path>
                    </svg>
                  </div>

                  <div class="text-sm font-semibold text-zinc-200">
                    Bitcoin (BTC)
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <button
                    class="rounded-lg bg-white/10 px-3 py-1.5 text-xs font-medium text-zinc-200 ring-1 ring-white/10 hover:bg-white/15"
                    type="button"
                    onclick={`copyToClipboard('btc')`}
                  >
                    {t(lang, "home.support.donate.btc.copy")}
                  </button>

                  <button
                    class="rounded-lg bg-white/10 px-3 py-1.5 text-xs font-medium text-zinc-200 ring-1 ring-white/10 hover:bg-white/15"
                    type="button"
                    onclick={`toggleQr('btc')`}
                  >
                    QR Code
                  </button>
                </div>
              </div>

              <div
                id="addr-btc"
                class="mt-3 break-all rounded-lg border border-white/10 bg-black/30 p-3 font-mono text-[11px] text-zinc-200"
                data-address="bc1qqjw2qyj276jkwdd0wxm4y4vyggsmr73y9nm066"
              >
                bc1qqjw2qyj276jkwdd0wxm4y4vyggsmr73y9nm066
              </div>

              <div id="qr-btc" class="mt-4 hidden">
                <img
                  src="/donate/btc.png"
                  alt={t(lang, "home.support.donate.btc.qralt")}
                  class="w-40 rounded-lg border border-white/10"
                />
