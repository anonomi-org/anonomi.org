        </a>

        <a
          href={localizedPath("/docs/support-us", lang)}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
        >
          {t(lang, "home.support.cta")} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
