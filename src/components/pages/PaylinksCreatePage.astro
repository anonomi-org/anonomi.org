---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import PaylinksOnionNotice from "../PaylinksOnionNotice.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";
import { PAYLINKS_ENABLED, paylinksApiBase } from "../../lib/paylinks";

const lang = getLangFromUrl(Astro.url);

const BUILD_SHA = import.meta.env.PUBLIC_BUILD_SHA ?? "";
const BUILD_SHORT = BUILD_SHA ? BUILD_SHA.slice(0, 7) : "dev";
const ONION_REPO = "http://ll7nb2gloylmzcnb4q6apax6zt4c5gbdvx73cvf7fj4frep7zsgdeoqd.onion/anonomi/anonomi.org";
const CLEARNET_REPO = "https://github.com/anonomi-org/anonomi.org";
const COMMIT_URL = BUILD_SHA ? `${ONION_REPO}/commit/${BUILD_SHA}` : ONION_REPO;
const CLEARNET_COMMIT_URL = BUILD_SHA ? `${CLEARNET_REPO}/commit/${BUILD_SHA}` : CLEARNET_REPO;

const API_BASE = paylinksApiBase();

const SITE_BASE =
  import.meta.env.PUBLIC_SITE_BASE_URL ?? "http://localhost:4321";

const scriptStrings = {
  submit: t(lang, "paylinks.create.submit"),
  working: t(lang, "paylinks.create.script.working"),
  created: t(lang, "paylinks.create.script.created"),
  defaultMinHelp: t(lang, "paylinks.create.script.defaultMinHelp"),
  defaultMaxHelp: t(lang, "paylinks.create.script.defaultMaxHelp"),
  optionalHelp: t(lang, "paylinks.create.script.optionalHelp"),
  randomHelp: t(lang, "paylinks.create.script.randomHelp"),
  minMaxError: t(lang, "paylinks.create.script.minMaxError"),
  spanError: t(lang, "paylinks.create.script.spanError"),
  rateLimited: t(lang, "paylinks.create.script.rateLimited"),
  copied: t(lang, "paylinks.create.script.copied"),
  copyFailed: t(lang, "paylinks.create.script.copyFailed"),
  networkError: t(lang, "paylinks.create.script.networkError"),
  verifySubaddress: t(lang, "paylinks.create.script.verifySubaddress"),
  subaddressPrefix: t(lang, "paylinks.create.script.subaddressPrefix"),
};

const privacyDocsPath = localizedPath("/docs/paylinks/privacy", lang);
const paylinksPath = localizedPath("/paylinks", lang);
---

<Layout
  title={t(lang, "paylinks.create.meta.title")}
  description={t(lang, "paylinks.create.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-2xl px-6 py-16">
    <div class="relative">
      <section
        class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12"
      >
        <p class="text-xs font-semibold tracking-widest text-zinc-400">{t(lang, "paylinks.create.tagline")}</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          {t(lang, "paylinks.create.heading")}
        </h1>

        {!PAYLINKS_ENABLED && (
          <div class="mt-6">
            <PaylinksOnionNotice path="/paylinks/create" />
          </div>
        )}

        {PAYLINKS_ENABLED && (
        <Fragment>
        <p class="mt-3 text-zinc-300">
          {t(lang, "paylinks.create.description")}
        </p>

        <p class="mt-3 flex items-start gap-2 text-xs text-zinc-500">
          <span
            aria-hidden="true"
            class="mt-[1px] font-medium"
            style="color:#ce27e6"
          >
            &#9432;
          </span>
          <span>
            {t(lang, "paylinks.create.noSpendKey.before")}
            {" "}
            <span class="font-medium text-zinc-400"
              >{t(lang, "paylinks.create.noSpendKey.highlight")}</span
            >.
            <a
              href={privacyDocsPath}
              target="_blank"
              rel="noopener noreferrer"
              class="ml-1 underline underline-offset-2 hover:text-zinc-300"
            >
              {t(lang, "paylinks.create.noSpendKey.learnMore")}
            </a>
          </span>
        </p>

        <form id="form" class="mt-8 space-y-6">
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-zinc-200"
                >{t(lang, "paylinks.create.label.address")}</label
              >
              <input
                name="publicAddress"
                required
                placeholder="4..."
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 font-mono text-[12px] text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
              <p class="mt-2 text-xs text-zinc-500">
                {t(lang, "paylinks.create.label.addressHelp")}
              </p>
            </div>

            <div>
              <label class="block text-sm font-medium text-zinc-200"
                >{t(lang, "paylinks.create.label.viewKey")}</label
              >
              {/* Password field to keep the key off the screen and out of
                  form history in browsers that aren't Tor Browser. */}
              <input
                name="privateViewKey"
                type="password"
                required
                placeholder="64-hex chars"
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 font-mono text-[12px] text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
              <p class="mt-2 text-xs text-zinc-500">
                {t(lang, "paylinks.create.label.viewKeyHelp")}
              </p>
            </div>
          </div>

          <!-- Options (no frame) -->
          <div id="optionsPanel" class="mt-6 space-y-4">
            <div>
              <label class="block text-sm font-medium text-zinc-200"
                >{t(lang, "paylinks.create.label.label")}</label
              >
              <input
                name="label"
                maxlength="80"
                placeholder="e.g., John's blog"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
              <p class="mt-2 text-xs text-zinc-500">
                {t(lang, "paylinks.create.label.labelHelp")}
              </p>
            </div>

            <!-- Mode + indices row -->
            <div class="grid gap-4 sm:grid-cols-4">
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-zinc-200"
                  >{t(lang, "paylinks.create.label.genMode")}</label
                >
                <select
                  id="genMode"
                  name="genMode"
                  class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-white/20"
                >
                  <option value="random" selected>{t(lang, "paylinks.create.label.genModeRandom")}</option>
                  <option value="sequential" disabled>{t(lang, "paylinks.create.label.genModeSequential")}</option>
                </select>
                <p id="genModeHelp" class="mt-2 text-xs text-zinc-500"></p>
              </div>

              <div class="sm:col-span-1">
                <label class="block text-sm font-medium text-zinc-200"
                  >{t(lang, "paylinks.create.label.minIndex")}</label
                >
                <input
                  id="minIndex"
                  name="minIndex"
                  type="number"
                  min="1"
                  step="1"
                  placeholder="e.g., 1 (optional)"
                  class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
                />
                <p id="minHelp" class="mt-2 text-xs text-zinc-500">{t(lang, "paylinks.create.script.optionalHelp")}</p>
              </div>

              <div class="sm:col-span-1">
                <label class="block text-sm font-medium text-zinc-200"
                  >{t(lang, "paylinks.create.label.maxIndex")}</label
                >
                <input
                  id="maxIndex"
                  name="maxIndex"
                  type="number"
                  min="1"
                  step="1"
                  placeholder="e.g., 500 (optional)"
                  class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
                />
                <p id="maxHelp" class="mt-2 text-xs text-zinc-500">{t(lang, "paylinks.create.script.optionalHelp")}</p>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <button
              id="submitBtn"
              type="submit"
              class="w-full sm:w-auto rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/15"
            >
              {t(lang, "paylinks.create.submit")}
            </button>
          </div>
        </form>

        <div id="status" class="mt-6 text-sm text-red-400"></div>

        <div id="result" class="mt-6 mb-6 hidden">
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <div class="text-sm font-semibold text-zinc-200">{t(lang, "paylinks.create.result.heading")}</div>

            <div id="verifyText" class="mt-3 text-xs text-zinc-400"></div>
            <div
              id="subaddressLine"
              class="mt-2 hidden rounded-lg border border-white/10 bg-black/30 px-3 py-2 text-xs text-zinc-300"
            >
            </div>
            <p class="mt-2 flex items-start gap-2 text-xs text-zinc-500">
              <span
                aria-hidden="true"
                class="mt-[1px] font-medium"
                style="color:#ce27e6"
              >
                &#9432;
              </span>
              <span>
                <span class="font-medium text-zinc-400">{t(lang, "paylinks.create.result.verifyImportant")}</span>
                {" "}{t(lang, "paylinks.create.result.verifyText")}
              </span>
            </p>
            <div class="mt-3 text-xs text-zinc-400">{t(lang, "paylinks.create.result.donateUrl")}</div>
            <div
              class="mt-1 font-mono text-[12px] text-zinc-200 break-all"
              id="donateUrl"
            >
            </div>

            <div class="mt-4 flex items-end justify-between gap-3">
              <div class="text-xs text-zinc-400">{t(lang, "paylinks.create.result.embedHtml")}</div>

              <div class="min-w-[180px]">
                <label for="embedStyle" class="sr-only">{t(lang, "paylinks.create.result.buttonStyle")}</label>
                <select
                  id="embedStyle"
                  class="w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:ring-2 focus:ring-white/20"
                >
                  <option value="link">{t(lang, "paylinks.create.result.styleLink")}</option>
                  <option value="pillSolid">{t(lang, "paylinks.create.result.stylePillSolid")}</option>
                  <option value="pillOutline">{t(lang, "paylinks.create.result.stylePillOutline")}</option>
                  <option value="icon" selected>{t(lang, "paylinks.create.result.styleIcon")}</option>
                  <option value="badge">{t(lang, "paylinks.create.result.styleBadge")}</option>
                </select>
              </div>
            </div>

            <textarea
              id="embedHtml"
              readonly
              class="mt-2 h-32 w-full resize-none rounded-xl border border-white/10 bg-black/30 p-3 font-mono text-[12px] text-zinc-100 focus:outline-none"
            ></textarea>

            <div
              class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <!-- Left: Copy -->
              <div class="flex items-center gap-3">
                <button
                  id="copyBtn"
                  type="button"
                  class="rounded-xl bg-white/10 px-3 py-2 text-xs font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/15"
                >
                  {t(lang, "paylinks.create.result.copySnippet")}
                </button>

                <div id="copyStatus" class="text-xs text-zinc-400"></div>
              </div>

              <!-- Right: Preview -->
              <div class="flex items-center justify-end gap-3">
                <div class="text-xs text-zinc-500">{t(lang, "paylinks.create.result.preview")}</div>

                <div
                  id="embedPreviewWrap"
                  class="inline-flex items-center justify-end"
                >
                  <div id="embedPreview"></div>
                </div>
              </div>
            </div>

            <div
              class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-8"
            >
              <!-- Fingerprint -->
              <div class="min-w-0">
                <div class="text-xs text-zinc-400">{t(lang, "paylinks.create.result.fingerprint")}</div>
                <div
                  id="paylinkFingerprint"
                  class="mt-1 font-mono text-[12px] text-zinc-200 whitespace-nowrap"
                >
                </div>
              </div>

              <!-- ID -->
              <div class="min-w-0">
                <div class="text-xs text-zinc-400">{t(lang, "paylinks.create.result.paylinkId")}</div>
                <div
                  id="paylinkId"
                  class="mt-1 font-mono text-[12px] text-zinc-200 whitespace-nowrap overflow-x-auto"
                >
                </div>
              </div>
            </div>
            <p class="mt-2 text-xs text-zinc-500">
              {t(lang, "paylinks.create.result.fingerprintNotice")}
            </p>
          </div>
        </div>
        </Fragment>
        )}

        <!-- Back button -->
        <div class="pt-2 flex items-center gap-3">
          <a
            href={paylinksPath}
            class="inline-flex rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
          >
            {t(lang, "paylinks.create.back")}
          </a>

          {PAYLINKS_ENABLED && (
          <button
            id="resetBtn"
            type="button"
            class="hidden rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/15"
          >
            {t(lang, "paylinks.create.createNew")}
          </button>
          )}
        </div>
      </section>

      <!-- Build footer OUTSIDE the box -->
      <div
        class="mt-4 flex items-center justify-end font-mono text-[11px] text-zinc-500"
      >
        <div>
          Build:
          <a href={COMMIT_URL} data-clearnet-href={CLEARNET_COMMIT_URL} class="text-zinc-300 hover:text-white">
            {BUILD_SHORT}
          </a>
        </div>
      </div>
    </div>
  </main>

  {PAYLINKS_ENABLED && (
  <script is:inline define:vars={{ API_BASE, SITE_BASE, scriptStrings }}>
    window.__PAYLINKS_API_BASE__ = API_BASE;
    window.__PAYLINKS_SITE_BASE__ = SITE_BASE;
    window.__PAYLINKS_STRINGS__ = scriptStrings;
  </script>

  <script>
    import {
      buildEmbedHtml,
      escapeHtml,
      firstDetailMessage,
      toIntOrUndef,
      validateIndexRange,
      wipeInput,
    } from "../../lib/paylinksClient";

    // Set by the inline script above. No localhost default: Astro bundles this
    // even on builds that never render the page, and a default would aim it at
    // whatever is on the visitor's own port.
    const API_BASE = window.__PAYLINKS_API_BASE__ || "";
    const SITE_BASE = window.__PAYLINKS_SITE_BASE__ || "";
    const scriptStrings = window.__PAYLINKS_STRINGS__ || {};

    const form = document.getElementById("form");
    const statusEl = document.getElementById("status");
    const resultEl = document.getElementById("result");
    const donateUrlEl = document.getElementById("donateUrl");
    const embedEl = document.getElementById("embedHtml");
    const fingerprintEl = document.getElementById("paylinkFingerprint");
    const paylinkIdEl = document.getElementById("paylinkId");
    const submitBtn = document.getElementById("submitBtn");
    const copyBtn = document.getElementById("copyBtn");
    const copyStatusEl = document.getElementById("copyStatus");
    const genModeEl = document.getElementById("genMode");
    const genModeHelp = document.getElementById("genModeHelp");
    const minHelp = document.getElementById("minHelp");
    const maxHelp = document.getElementById("maxHelp");
    const embedStyleEl = document.getElementById("embedStyle");
    const embedPreviewEl = document.getElementById("embedPreview");

    const resetBtn = document.getElementById("resetBtn");
    resetBtn?.classList.add("hidden");

    const verifyTextEl = document.getElementById("verifyText");
    const subaddressLineEl = document.getElementById("subaddressLine");

    const viewKeyEl = form?.querySelector('[name="privateViewKey"]');

    let paylinkCreated = false;

    function setStatus(msg) {
      statusEl.textContent = msg || "";
    }

    function resetUI() {
      // reset state
      paylinkCreated = false;

      if (embedStyleEl) embedStyleEl.value = "icon";

      if (resetBtn) {
        resetBtn.classList.add("hidden");
        resetBtn.classList.remove("inline-flex");
      }

      // reset form fields
      form.reset();

      // restore default mode + help text
      if (genModeEl) genModeEl.value = "random";
      syncIndexHelp();

      // clear status + result area
      setStatus("");
      resultEl.classList.add("hidden");

      // clear generated content
      donateUrlEl.textContent = "";
      embedEl.value = "";
      fingerprintEl.textContent = "";
      paylinkIdEl.textContent = "";
      if (embedPreviewEl) embedPreviewEl.innerHTML = "";

      // clear verification texts
      if (verifyTextEl) verifyTextEl.textContent = "";
      if (subaddressLineEl) {
        subaddressLineEl.innerHTML = "";
        subaddressLineEl.classList.add("hidden");
      }

      // clear copy status
      if (copyStatusEl) copyStatusEl.textContent = "";

      // re-enable submit button (and remove disabled styling)
      submitBtn.disabled = false;
      submitBtn.textContent = scriptStrings.submit;
      submitBtn.classList.remove("opacity-60", "cursor-not-allowed");
    }

    resetBtn?.addEventListener("click", resetUI);

    function syncIndexHelp() {
      const mode = String(genModeEl?.value || "")
        .trim()
        .toLowerCase();
      if (mode === "random") {
        minHelp.textContent = scriptStrings.defaultMinHelp;
        maxHelp.textContent = scriptStrings.defaultMaxHelp;
        if (genModeHelp)
          genModeHelp.textContent = scriptStrings.randomHelp;
      } else {
        minHelp.textContent = scriptStrings.optionalHelp;
        maxHelp.textContent = scriptStrings.optionalHelp;
      }
    }

    // validateIndexRange returns a reason; the translated text stays here
    // rather than in the shared module.
    const INDEX_RANGE_MESSAGES = {
      minMax: () => scriptStrings.minMaxError,
      span: () => scriptStrings.spanError,
    };

    genModeEl?.addEventListener("change", syncIndexHelp);

    function buildOptions(fd) {
      const labelRaw = String(fd.get("label") || "").slice(0, 80);
      const label = labelRaw.trim();
      const genMode = String(fd.get("genMode") || "").trim();
      const minIndex = toIntOrUndef(fd.get("minIndex"));
      const maxIndex = toIntOrUndef(fd.get("maxIndex"));

      const options = {};

      // only include fields that are actually set
      if (label) options.label = label;
      if (genMode) options.genMode = genMode;
      if (minIndex !== undefined) options.minIndex = minIndex;
      if (maxIndex !== undefined) options.maxIndex = maxIndex;

      return Object.keys(options).length ? options : undefined;
    }

    function renderEmbedPreview(donateUrl, style) {
      if (!embedPreviewEl) return;
      const html = buildEmbedHtml(donateUrl, style);

      // Extract the actual <a ...>...</a> to display (drop the comment line)
      const aHtml = html.split("\n").find((l) => l.trim().startsWith("<a"))
        ? html.replace(/^<!--.*?-->\n?/m, "")
        : html;

      embedPreviewEl.innerHTML = aHtml;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (paylinkCreated) return;
      setStatus("");
      resultEl.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = scriptStrings.working;

      const fd = new FormData(form);
      const payload = {
        publicAddress: String(fd.get("publicAddress") || "").trim(),
        privateViewKey: String(fd.get("privateViewKey") || "").trim(),
      };

      const submittedOptions = buildOptions(fd);

      if (submittedOptions) {
        const reason = validateIndexRange(
          submittedOptions.minIndex,
          submittedOptions.maxIndex,
        );

        if (reason) {
          setStatus(`Error: ${INDEX_RANGE_MESSAGES[reason]()}`);
          submitBtn.disabled = false;
          submitBtn.textContent = scriptStrings.submit;
          return;
        }

        payload.options = submittedOptions;
      }

      try {
        const res = await fetch(`${API_BASE}/api/paylinks`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));

        if (copyStatusEl) copyStatusEl.textContent = "";

        if (!res.ok) {
          // Rate limiting is reported as a plain Fastify error body with no
          // details, so it is handled before the field-level messages.
          if (res.status === 429) {
            setStatus(scriptStrings.rateLimited);
            console.error("create paylink failed:", data);
            return;
          }

          const detailMsg = firstDetailMessage(data?.details);

          setStatus(
            detailMsg
              ? `Error: ${detailMsg}`
              : data?.error
                ? `Error: ${data.error}`
                : `Error: ${res.status}`,
          );
          console.error("create paylink failed:", data);
          return;
        }

        // Build donate URL from SITE_BASE (set at build time for security)
        const donateUrl = `${SITE_BASE}/paylinks/d#${data.id}`;
        donateUrlEl.textContent = donateUrl;

        // Generate embed HTML from selected preset (default to pillSolid if missing)
        const style = String(embedStyleEl?.value || "icon");
        embedEl.value = buildEmbedHtml(donateUrl, style);
        renderEmbedPreview(donateUrl, style);
        fingerprintEl.textContent = data.fingerprint || ""; // server returns `fingerprint`
        paylinkIdEl.textContent = data.id || "";

        const minIndex = data.minIndex;
        const addressPreview = data.addressPreview || "";

        if (verifyTextEl && Number.isInteger(minIndex)) {
          verifyTextEl.textContent = `${scriptStrings.verifySubaddress}${minIndex}`;
        }

        if (subaddressLineEl && Number.isInteger(minIndex) && addressPreview) {
          subaddressLineEl.innerHTML = `${scriptStrings.subaddressPrefix}${minIndex}: <span class="font-mono text-zinc-200">${escapeHtml(
            addressPreview,
          )}</span>`;
          subaddressLineEl.classList.remove("hidden");
        }

        resultEl.classList.remove("hidden");
        paylinkCreated = true;
        submitBtn.disabled = true;
        submitBtn.textContent = scriptStrings.created;
        submitBtn.classList.add("opacity-60", "cursor-not-allowed");
        if (resetBtn) {
          resetBtn.classList.remove("hidden");
          resetBtn.classList.add("inline-flex");
        }

        // The paylink exists and the key is spent, so stop holding it. The
        // address stays — it's public, and it's what the result is checked
        // against.
        wipeInput(viewKeyEl);
      } catch (err) {
        console.error(err);
        setStatus(scriptStrings.networkError);
      } finally {
        if (!paylinkCreated) {
          submitBtn.disabled = false;
          submitBtn.textContent = scriptStrings.submit;
        }
      }
    });

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(embedEl.value);

        // show under button
        if (copyStatusEl) {
          copyStatusEl.textContent = scriptStrings.copied;
          setTimeout(() => {
            // only clear if it still says Copied (avoid nuking a newer msg)
            if (copyStatusEl.textContent === scriptStrings.copied)
              copyStatusEl.textContent = "";
          }, 1500);
        }
      } catch {
        // copy failures AREN'T form errors, but you can still show it near the button
        if (copyStatusEl)
          copyStatusEl.textContent = scriptStrings.copyFailed;
      }
    });

    embedStyleEl?.addEventListener("change", () => {
      const donateUrl = String(donateUrlEl?.textContent || "").trim();
      if (!donateUrl) return;

      const style = String(embedStyleEl.value || "icon");
      embedEl.value = buildEmbedHtml(donateUrl, style);
      renderEmbedPreview(donateUrl, style);
    });

    // initial help text
    syncIndexHelp();
  </script>
  )}
</Layout>
