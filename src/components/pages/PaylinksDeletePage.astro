---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import PaylinksOnionNotice from "../PaylinksOnionNotice.astro";
import BuildStamp from "../BuildStamp.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";
import { PAYLINKS_ENABLED, paylinksApiBase } from "../../lib/paylinks";

const lang = getLangFromUrl(Astro.url);


const API_BASE = paylinksApiBase();

const scriptStrings = {
  submit: t(lang, "paylinks.delete.submit"),
  working: t(lang, "paylinks.delete.script.working"),
  done: t(lang, "paylinks.delete.script.done"),
  confirmBulk: t(lang, "paylinks.delete.script.confirmBulk"),
  viewKeyError: t(lang, "paylinks.delete.script.viewKeyError"),
  networkError: t(lang, "paylinks.delete.script.networkError"),
  insecureContext: t(lang, "paylinks.delete.script.insecureContext"),
};

const paylinksPath = localizedPath("/paylinks", lang);
const createPath = localizedPath("/paylinks/create", lang);
---

<Layout
  title={t(lang, "paylinks.delete.meta.title")}
  description={t(lang, "paylinks.delete.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-2xl px-6 py-16">
    <div class="relative">
      <section
        class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12"
      >
        <p class="text-xs font-semibold tracking-widest text-zinc-400">{t(lang, "paylinks.delete.tagline")}</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          {t(lang, "paylinks.delete.heading")}
        </h1>

        {!PAYLINKS_ENABLED && (
          <div class="mt-6">
            <PaylinksOnionNotice path="/paylinks/delete" />
          </div>
        )}

        {PAYLINKS_ENABLED && (
        <Fragment>
        <p class="mt-3 text-zinc-300">
          {t(lang, "paylinks.delete.description.before")}
          {" "}<span class="font-medium text-zinc-200">{t(lang, "paylinks.delete.description.highlight")}</span>{" "}
          {t(lang, "paylinks.delete.description.after")}
        </p>

        <p class="mt-3 flex items-start gap-2 text-xs text-zinc-500">
          <span
            aria-hidden="true"
            class="mt-[1px] font-medium"
            style="color:#ce27e6"
          >
            &#9432;
          </span>
          <span>
            {t(lang, "paylinks.delete.info.before")} <span
              class="font-medium text-zinc-400">{t(lang, "paylinks.delete.info.highlight")}</span
            >
            {" "}{t(lang, "paylinks.delete.info.after")}
          </span>
        </p>

        <form id="form" class="mt-8 space-y-6">
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-zinc-200">
                {t(lang, "paylinks.delete.label.address")}
              </label>
              <input
                name="publicAddress"
                required
                placeholder="4..."
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 font-mono text-[12px] text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-zinc-200">
                {t(lang, "paylinks.delete.label.viewKey")}
              </label>
              {/* Deliberately not type="password": some browsers treat a
                  password field beside an address field as a credential pair
                  and offer to save it, which is not somewhere a view key
                  should end up. autocomplete stays off either way. */}
              <input
                name="privateViewKey"
                required
                placeholder="64-hex chars"
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 font-mono text-[12px] text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-zinc-200">
                {t(lang, "paylinks.delete.label.paylinkId")}
              </label>
              <input
                id="paylinkId"
                name="paylinkId"
                placeholder="e.g., 2f4c1a0e-..."
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                class="mt-2 w-full rounded-xl border border-white/10 bg-black/30 px-4 py-2 font-mono text-[12px] text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20"
              />
              <p class="mt-2 text-xs text-zinc-500">
                {t(lang, "paylinks.delete.label.paylinkIdHelp")}
              </p>
            </div>
          </div>

          <!-- Danger confirmation only required for bulk -->
          <div
            id="bulkConfirmWrap"
            class="hidden rounded-2xl border border-white/10 bg-black/20 p-4"
          >
            <div class="text-sm font-semibold text-zinc-200">
              {t(lang, "paylinks.delete.bulkConfirm.heading")}
            </div>
            <p class="mt-2 text-xs text-zinc-500">
              {t(lang, "paylinks.delete.bulkConfirm.text.before")}
              {" "}<span class="font-medium text-zinc-300">{t(lang, "paylinks.delete.bulkConfirm.text.highlight")}</span>{" "}
              {t(lang, "paylinks.delete.bulkConfirm.text.after")}
            </p>

            <label class="mt-3 flex items-start gap-3 text-xs text-zinc-300">
              <input
                id="bulkConfirm"
                type="checkbox"
                class="mt-0.5 h-4 w-4 rounded border-white/20 bg-black/40"
              />
              <span>
                {t(lang, "paylinks.delete.bulkConfirm.checkbox")}
              </span>
            </label>
          </div>

          <div class="pt-2 flex items-center gap-3">
            <button
              id="submitBtn"
              type="submit"
              class="w-full sm:w-auto rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/15"
            >
              {t(lang, "paylinks.delete.submit")}
            </button>

            <button
              id="resetBtn"
              type="button"
              class="hidden rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/15"
            >
              {t(lang, "paylinks.delete.reset")}
            </button>
          </div>
        </form>

        <div id="status" class="mt-6 text-sm text-red-400"></div>

        <div id="result" class="mt-6 hidden">
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <div class="text-sm font-semibold text-zinc-200">{t(lang, "paylinks.delete.result.heading")}</div>
            <div id="resultText" class="mt-2 text-xs text-zinc-400"></div>
          </div>
        </div>
        </Fragment>
        )}

        <div class="mt-8 pt-2 flex items-center gap-3">
          <a
            href={paylinksPath}
            class="inline-flex rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
          >
            {t(lang, "paylinks.delete.back")}
          </a>

          <a
            href={createPath}
            class="inline-flex rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
          >
            {t(lang, "paylinks.delete.createPaylink")}
          </a>
        </div>
      </section>

      <!-- Build footer OUTSIDE the box -->
      <div
        class="mt-4 flex items-center justify-end font-mono text-[11px] text-zinc-500"
      >
        <BuildStamp />
      </div>
    </div>
  </main>

  {PAYLINKS_ENABLED && (
  <script is:inline define:vars={{ API_BASE, scriptStrings }}>
    window.__PAYLINKS_API_BASE__ = API_BASE;
    window.__PAYLINKS_STRINGS__ = scriptStrings;
  </script>

  <script>
    import {
      InsecureContextError,
      computeOwnerKey,
      isViewKeyShape,
      wipeInput,
    } from "../../lib/paylinksClient";

    // Set by the inline script above. No localhost default: Astro bundles this
    // even on builds that never render the page, and a default would aim it at
    // whatever is on the visitor's own port.
    const API_BASE = window.__PAYLINKS_API_BASE__ || "";
    const scriptStrings = window.__PAYLINKS_STRINGS__ || {};

    const form = document.getElementById("form");
    const statusEl = document.getElementById("status");
    const resultEl = document.getElementById("result");
    const resultTextEl = document.getElementById("resultText");
    const submitBtn = document.getElementById("submitBtn");
    const resetBtn = document.getElementById("resetBtn");

    const paylinkIdEl = document.getElementById("paylinkId");
    const bulkConfirmWrap = document.getElementById("bulkConfirmWrap");
    const bulkConfirm = document.getElementById("bulkConfirm");

    const viewKeyEl = form?.querySelector('[name="privateViewKey"]');

    function setStatus(msg) {
      statusEl.textContent = msg || "";
    }

    function showBulkConfirmIfNeeded() {
      const id = String(paylinkIdEl?.value || "").trim();
      const isBulk = !id;

      if (isBulk) {
        bulkConfirmWrap?.classList.remove("hidden");
      } else {
        bulkConfirmWrap?.classList.add("hidden");
        if (bulkConfirm) bulkConfirm.checked = false;
      }
    }

    paylinkIdEl?.addEventListener("input", showBulkConfirmIfNeeded);

    function resetUI() {
      form.reset();
      setStatus("");
      resultEl.classList.add("hidden");
      if (resultTextEl) resultTextEl.textContent = "";

      submitBtn.disabled = false;
      submitBtn.textContent = scriptStrings.submit;
      submitBtn.classList.remove("opacity-60", "cursor-not-allowed");

      resetBtn?.classList.add("hidden");

      if (bulkConfirm) bulkConfirm.checked = false;
      showBulkConfirmIfNeeded();
    }

    resetBtn?.addEventListener("click", resetUI);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setStatus("");
      resultEl.classList.add("hidden");

      const fd = new FormData(form);
      const publicAddress = String(fd.get("publicAddress") || "").trim();
      const privateViewKey = String(fd.get("privateViewKey") || "").trim();
      const paylinkId = String(fd.get("paylinkId") || "").trim();

      const isBulk = !paylinkId;

      if (isBulk && !bulkConfirm?.checked) {
        setStatus(scriptStrings.confirmBulk);
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = scriptStrings.working;

      try {
        if (!isViewKeyShape(privateViewKey)) {
          setStatus(scriptStrings.viewKeyError);
          submitBtn.disabled = false;
          submitBtn.textContent = scriptStrings.submit;
          return;
        }

        // Compute ownerKey locally; send ONLY ownerKey to server
        const ownerKey = await computeOwnerKey(publicAddress, privateViewKey);

        let url = "";
        const body = { ownerKey };

        if (paylinkId) {
          url = `${API_BASE}/api/paylinks/${encodeURIComponent(paylinkId)}/delete`;
        } else {
          url = `${API_BASE}/api/paylinks/delete`;
        }

        const res = await fetch(url, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          const err = data?.error
            ? `Error: ${data.error}`
            : `Error: ${res.status}`;
          setStatus(err);
          submitBtn.disabled = false;
          submitBtn.textContent = scriptStrings.submit;
          return;
        }

        const msg = String(data?.message || "Done.");

        if (resultTextEl) resultTextEl.textContent = msg;
        resultEl.classList.remove("hidden");

        submitBtn.disabled = true;
        submitBtn.textContent = scriptStrings.done;
        submitBtn.classList.add("opacity-60", "cursor-not-allowed");

        resetBtn?.classList.remove("hidden");

        // Done with the key, so stop holding it.
        wipeInput(viewKeyEl);
      } catch (err) {
        // No Web Crypto means no owner key, and retrying won't change that.
        // Say so instead of blaming the network, and drop the key.
        if (err instanceof InsecureContextError) {
          setStatus(scriptStrings.insecureContext);
          wipeInput(viewKeyEl);
        } else {
          // Kept on purpose: this is retryable, and clearing it would mean
          // retyping the key after a dropped connection.
          console.error(err);
          setStatus(scriptStrings.networkError);
        }

        submitBtn.disabled = false;
        submitBtn.textContent = scriptStrings.submit;
      }
    });

    showBulkConfirmIfNeeded();
  </script>
  )}
</Layout>
