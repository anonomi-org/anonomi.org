            const isHidden = target.classList.toggle('hidden');
            const arrow = btn.querySelector('.toggle-arrow');
            if (arrow) (arrow as HTMLElement).style.transform = isHidden ? '' : 'rotate(180deg)';
          });
        });

        document.querySelectorAll('.copy-hash').forEach((btn) => {
          btn.addEventListener('click', () => {
            const hash = btn.getAttribute('data-hash');
            if (!hash) return;
            navigator.clipboard.writeText(hash).then(() => {
              const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
              const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
              if (copyIcon) copyIcon.classList.add('hidden');
              if (checkIcon) checkIcon.classList.remove('hidden');
              setTimeout(() => {
                if (copyIcon) copyIcon.classList.remove('hidden');
                if (checkIcon) checkIcon.classList.add('hidden');
              }, 2000);
            });
          });
        });
      </script>

