---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import Footer from "../Footer.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";
import { fetchReleases } from "../../lib/releases";
import FeatureCard from "../FeatureCard.astro";
import { ONION_REPO_BASE, net, repoUrl } from "../../lib/site";

const lang = getLangFromUrl(Astro.url);

// Newest naming first. The postbox APK was renamed at v1.0.5, so both names are
// listed to keep the older releases on the page alongside the new ones.
const MESSENGER_APK = ["anonomi-official-release.apk"];
const POSTBOX_APK = ["anonomi-postbox-release.apk", "postbox-android-release.apk"];

/** A release asset on the onion mirror. The releases API gives us the clearnet URL. */
function onionAsset(repo: string, version: string, asset: string): string {
  return `${ONION_REPO_BASE}/${repo}/releases/download/${version}/${asset}`;
}

// On the onion build the badge points at our downloads page, which carries
// F-Droid's own onion address; f-droid.org itself is not reachable there.
const FDROID_URL = net(
  localizedPath("/docs/downloads", lang) + "#f-droid",
  "https://f-droid.org/packages/org.anonomi.android/",
);

const messengerReleases = await fetchReleases("anonomi-org/anonomi-android", MESSENGER_APK, 4);
const postboxReleases = await fetchReleases("anonomi-org/anonomi-postbox", POSTBOX_APK, 4);
---

<Layout
  title={t(lang, "messenger.meta.title")}
  description={t(lang, "messenger.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-6xl px-6 py-16">
    <!-- HERO -->
    <section
      class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12"
    >
      <div
