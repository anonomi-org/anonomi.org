---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import Footer from "../Footer.astro";
import { getLangFromUrl, localizedPath, t } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<Layout
  title={t(lang, "messenger.meta.title")}
  description={t(lang, "messenger.meta.description")}
>
  <NavBar />

  <main class="mx-auto max-w-6xl px-6 py-16">
    <!-- HERO -->
    <section
      class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12"
    >
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-white/10 via-transparent to-transparent"
      >
      </div>

      <div
        class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="max-w-2xl">
          <p class="text-xs font-semibold tracking-widest text-zinc-400">
            {t(lang, "messenger.hero.tagline")}
          </p>

          <h1
            class="mt-6 text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl"
          >
            {t(lang, "messenger.hero.heading")}
          </h1>

          <p class="mt-4 text-zinc-300">
            {t(lang, "messenger.hero.description")}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#download"
              class="rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10 hover:bg-white/15"
            >
              {t(lang, "messenger.hero.download")}
            </a>
            <a
              href="#features"
              class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-100 ring-1 ring-white/15 hover:bg-white/5"
            >
              {t(lang, "messenger.hero.features")}
            </a>
            <a
              href={localizedPath("/#manifesto", lang)}
              class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-300 ring-1 ring-white/10 hover:bg-white/5"
            >
              {t(lang, "messenger.hero.manifesto")}
            </a>
          </div>

          <p class="mt-6 text-xs text-zinc-500">
            {t(lang, "messenger.hero.disclaimer")}
          </p>
        </div>

        <!-- HERO SCREENSHOT -->
        <div class="w-full max-w-lg flex justify-center">
          <img
            src="/screenshots/intro.png"
            alt={t(lang, "messenger.hero.imgAlt")}
            loading="lazy"
            class="max-h-[520px] w-auto rounded-2xl border border-white/10 shadow-2xl"
          />
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="mt-24 scroll-mt-24">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {t(lang, "messenger.features.heading")}
      </h2>

      <div class="mt-4 h-[2px] w-20 rounded-full bg-[#6d4aff]"></div>

      <p class="mt-4 max-w-3xl text-base text-zinc-400 sm:text-lg">
        {t(lang, "messenger.features.description")}
      </p>

      <!-- Category pillars -->
      <div class="mt-16 grid gap-10 sm:grid-cols-3">
        <!-- Communication -->
        <a href="#communication" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 10h8m-8 4h5m9-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {t(lang, "messenger.features.communication")}
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "messenger.cat.communication.desc")}
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Privacy & Safety -->
        <a href="#privacy-safety" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {t(lang, "messenger.cat.privacy")}
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "messenger.cat.privacy.desc")}
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>

        <!-- Offline & Network -->
        <a href="#offline-network" class="group block">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            >
              <svg
                class="h-5 w-5 text-zinc-300"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7.5 12h9m-9 0a4.5 4.5 0 119 0m-9 0a4.5 4.5 0 009 0M4.5 12a7.5 7.5 0 1115 0 7.5 7.5 0 01-15 0z"></path>
              </svg>
            </div>

            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {t(lang, "messenger.cat.offline")}
            </h3>
          </div>

          <p
            class="mt-3 max-w-sm text-base text-zinc-400 group-hover:text-zinc-300"
          >
            {t(lang, "messenger.cat.offline.desc")}
          </p>

          <div class="mt-4 h-px w-16 bg-white/20 group-hover:bg-white/40"></div>
        </a>
      </div>

      <!-- ═══════════════════════════════════════════ -->
      <!-- COMMUNICATION                              -->
      <!-- ═══════════════════════════════════════════ -->
      <div id="communication" class="mt-20 scroll-mt-24">
        <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          {t(lang, "messenger.features.communication")}
        </h3>
        <div class="mt-2 h-px w-12 bg-white/20"></div>
      </div>

      <div class="mt-10 space-y-14">
        <!-- Messaging -->
        <div id="feature-messaging" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 10h8m-8 4h5m9-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">{t(lang, "messenger.messaging.title")}</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                {t(lang, "messenger.messaging.desc")}
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.messaging.noServers")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.messaging.noServers.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.messaging.tor")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.messaging.tor.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.messaging.offline")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.messaging.offline.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.messaging.media")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.messaging.media.desc")}</p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href={localizedPath("/docs/features/connectivity", lang)}
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  {t(lang, "messenger.messaging.link")}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/messaging.png">
                  <img
                    src="/screenshots/messaging.png"
                    alt={t(lang, "messenger.messaging.imgAlt")}
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Groups & Open Groups -->
        <div id="feature-groups" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">{t(lang, "messenger.groups.title")}</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                {t(lang, "messenger.groups.desc")}
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.groups.private")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.groups.private.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.groups.open")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.groups.open.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.groups.media")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.groups.media.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.groups.threads")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.groups.threads.desc")}</p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href={localizedPath("/docs/features/groups", lang)}
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  {t(lang, "messenger.groups.link")}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/groups.png">
                  <img
                    src="/screenshots/groups.png"
                    alt={t(lang, "messenger.groups.imgAlt")}
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Voice Messages -->
        <div id="feature-voice" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">{t(lang, "messenger.voice.title")}</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                {t(lang, "messenger.voice.desc")}
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.voice.record")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.voice.record.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.voice.encrypted")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.voice.encrypted.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.voice.everywhere")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.voice.everywhere.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.voice.playback")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.voice.playback.desc")}</p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href={localizedPath("/docs/features/voice", lang)}
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  {t(lang, "messenger.voice.link")}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/voice.png">
                  <img
                    src="/screenshots/voice.png"
                    alt={t(lang, "messenger.voice.imgAlt")}
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Walkie-Talkie -->
        <div id="feature-walkie-talkie" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m3.75 7.5 16.5-4.125M12 6.75c-2.708 0-5.363.224-7.948.655C2.999 7.58 2.25 8.507 2.25 9.574v9.176A2.25 2.25 0 0 0 4.5 21h15a2.25 2.25 0 0 0 2.25-2.25V9.574c0-1.067-.75-1.994-1.802-2.169A48.329 48.329 0 0 0 12 6.75Zm-1.683 6.443-.005.005-.006-.005.006-.005.005.005Zm-.005 2.127-.005-.006.005-.005.005.005-.005.006Zm-2.116-.006-.005.006-.006-.006.005-.005.006.005Zm-.005-2.116-.006-.005.006-.005.005.005-.005.005ZM9.255 10.5v.008h-.008V10.5h.008Zm3.249 1.88-.007.004-.003-.007.006-.003.004.006Zm-1.38 5.126-.003-.006.006-.004.004.007-.006.003Zm.007-6.501-.003.006-.007-.003.004-.007.006.004Zm1.37 5.129-.007-.004.004-.006.006.003-.004.007Zm.504-1.877h-.008v-.007h.008v.007ZM9.255 18v.008h-.008V18h.008Zm-3.246-1.87-.007.004L6 16.127l.006-.003.004.006Zm1.366-5.119-.004-.006.006-.004.004.007-.006.003ZM7.38 17.5l-.003.006-.007-.003.004-.007.006.004Zm-1.376-5.116L6 12.38l.003-.007.007.004-.004.007Zm-.5 1.873h-.008v-.007h.008v.007ZM17.25 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm0 4.5a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"></path>
                  </svg>
                </div>
                <h4 class="text-2xl font-semibold tracking-tight">{t(lang, "messenger.walkie.title")}</h4>
              </div>

              <p class="mt-3 max-w-3xl text-base text-zinc-400">
                {t(lang, "messenger.walkie.desc")}
              </p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.walkie.trigger")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.walkie.trigger.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.walkie.autoplay")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.walkie.autoplay.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.walkie.oneConvo")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.walkie.oneConvo.desc")}</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div class="text-base font-semibold">{t(lang, "messenger.walkie.encrypted")}</div>
                  <p class="mt-2 text-sm text-zinc-400">{t(lang, "messenger.walkie.encrypted.desc")}</p>
                </div>
              </div>

              <div class="mt-6">
                <a
                  href={localizedPath("/docs/features/walkie-talkie", lang)}
                  class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-white"
                >
                  {t(lang, "messenger.walkie.link")}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
            <div class="relative overflow-hidden rounded-xl h-[420px] lg:h-auto">
              <button class="screenshot-trigger cursor-pointer absolute inset-0" data-full="/screenshots/walkie-talkie.png">
                  <img
                    src="/screenshots/walkie-talkie.png"
                    alt={t(lang, "messenger.walkie.imgAlt")}
                    loading="lazy"
                    class="h-full w-full rounded-xl border border-white/10 object-cover object-top"
                  />
                </button>
            </div>
          </div>
        </div>

        <!-- Blogs -->
        <div id="feature-blogs" class="scroll-mt-24">
          <div
            class="flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_320px] lg:gap-8"
          >
            <div class="max-w-2xl">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5"
                >
                  <svg
                    class="h-5 w-5 text-zinc-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
